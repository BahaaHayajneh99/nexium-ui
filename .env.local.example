# Copy this file to `.env.local` (already gitignored) to run `vercel dev` locally against the
# api/*.js serverless functions (verifyLicenseToken, claimLicenseToken, sendLicenseEmail) without
# touching production. `vercel dev` loads this file automatically; real deploys set the same
# names as Vercel Environment Variables in the dashboard instead (Project Settings > Environment
# Variables - mark the secret-ish ones as "Sensitive").

# PayPal SANDBOX app credentials, from developer.paypal.com > Apps & Credentials > (your app,
# sandbox mode). The deployed production site uses a LIVE app's credentials instead.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# From resend.com > API Keys - needed for sendLicenseEmail (emailing a purchased token to the
# buyer). Not needed just to test the PayPal/claim flow.
RESEND_API_KEY=your-resend-api-key

# A Firebase service-account key's fields (Console > Project Settings > Service Accounts >
# Generate new private key) - lets these functions read/write the Realtime Database without
# needing the Blaze plan (Admin SDK access isn't gated by billing, only Cloud Functions are).
FIREBASE_PROJECT_ID=nexium-ui
FIREBASE_CLIENT_EMAIL=your-service-account@nexium-ui.iam.gserviceaccount.com
# Keep the real multi-line key's "\n" sequences literal (don't un-escape them in this file) -
# api/_lib/firebase-admin.js restores the real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR KEY HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://nexium-ui-default-rtdb.firebaseio.com
