# Copy this file to `.secret.local` (already gitignored) and fill in your PayPal SANDBOX app's
# credentials from developer.paypal.com > Apps & Credentials > (your app, sandbox mode).
# The Firebase emulator reads this file automatically for defineSecret() values - real deploys
# use `firebase functions:secrets:set` instead, this file is never used in production.

PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
